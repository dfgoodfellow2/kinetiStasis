# Server
PORT=8080
ENV=development
DB_PATH=./data/diet.db

# Custom domain (used for CORS in production)
APP_DOMAIN=https://your-domain.com

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Gemini AI (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Text parsing model / multimodal meal-photo model
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash

# Litestream backup — Tigris (or any S3-compatible)
# Create bucket at https://console.tigris.dev
# These names match what litestream.yml interpolates and what
# `fly storage create` injects automatically.
# Both endpoints work: t3.storage.dev is Tigris's current global
# endpoint (used in production); fly.storage.tigris.dev also works
# for fly-provisioned buckets.
BUCKET_NAME=your-bucket
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_ACCESS_KEY_ID=tid_xxx
AWS_SECRET_ACCESS_KEY=tsec_xxx
